# Duron Core - Environment Variables

# PostgreSQL connection string (required for PostgreSQL adapter)
DATABASE_URL=postgres://duron:duron@localhost:5435/duron

# JWT secret for dashboard authentication (required if using dashboard)
JWT_SECRET=your-secret-key-here

# OpenAI API key (required for AI examples)
OPENAI_API_KEY=sk-your-openai-api-key-here
